diff --git a/arm9/source/App.cpp b/arm9/source/App.cpp
index 4c3d92d..737f1f0 100644
--- a/arm9/source/App.cpp
+++ b/arm9/source/App.cpp
@@ -32,6 +32,24 @@
 
 #define SPLASH_FRAMES       44
 
+// Where the splash's tilemap sits in sub BG VRAM, and therefore how much room the tile
+// data has below it. The screen base in REG_BG1CNT_SUB below must agree: 0xC000 is
+// screen base block 24, since a block is 2KB.
+//
+// This used to be 0x3000, which left room for only 192 unique 8bpp tiles. The stock
+// splash reduces to 150 and fit, but anything with photographic detail does not, and the
+// tile data would have run straight over the tilemap. 0xC000 holds a full screen of 768
+// distinct tiles, so any 256-colour image works. Nothing else is on screen while the
+// splash is up, and VRAM C gives the sub engine 128KB here, so the space is free.
+#define SPLASH_MAP_OFFSET   0xC000
+
+static_assert(splashTopTilesLen <= SPLASH_MAP_OFFSET,
+              "splashTop tile data would overwrite the tilemap: reduce the detail in "
+              "arm9/gfx/splashTop.png, or raise SPLASH_MAP_OFFSET and the screen base in "
+              "REG_BG1CNT_SUB to match");
+static_assert(SPLASH_MAP_OFFSET % 2048 == 0,
+              "the tilemap must start on a 2KB screen base block boundary");
+
 App::App(IAppSettingsService& appSettingsService, IBgmService& bgmService)
     : _mainObjPltt(GFX_PLTT_OBJ_MAIN)
     , _mainObjVram(GFX_OBJ_MAIN)
@@ -68,7 +86,7 @@ void App::InitVramMapping() const
 void App::DisplaySplashScreen() const
 {
     dma_ntrCopy32(3, splashTopTiles, GFX_BG_SUB, splashTopTilesLen);
-    dma_ntrCopy32(3, splashTopMap, (u8*)GFX_BG_SUB + 0x3000, splashTopMapLen);
+    dma_ntrCopy32(3, splashTopMap, (u8*)GFX_BG_SUB + SPLASH_MAP_OFFSET, splashTopMapLen);
     mem_setVramHMapping(MEM_VRAM_H_LCDC);
     dma_ntrCopy32(3, splashTopPal, (void*)0x0689A000, splashTopPalLen);
     mem_setVramHMapping(MEM_VRAM_H_SUB_BG_EXT_PLTT_SLOT_0123);
@@ -79,7 +97,8 @@ void App::DisplaySplashScreen() const
     REG_DISPCNT_SUB = 0x40211015;
     REG_BG1HOFS_SUB = 0;
     REG_BG1VOFS_SUB = 0;
-    REG_BG1CNT_SUB = 0x0680;
+    // Character base 0, 256 colours, screen base SPLASH_MAP_OFFSET / 2048.
+    REG_BG1CNT_SUB = 0x0080 | ((SPLASH_MAP_OFFSET / 2048) << 8);
     REG_DISPCNT_SUB |= 1 << 9;
     REG_BLDCNT_SUB = 0x3D42;
     REG_BLDALPHA_SUB = 0x10;
